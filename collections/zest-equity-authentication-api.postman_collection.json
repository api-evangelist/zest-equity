        {
          "id": "69eb9bba-843a-45a0-960e-b882fdc97402",
          "name": "Inspect the current access token",
          "request": {
            "name": "Inspect the current access token",
            "description": {
              "content": "Returns metadata about the bearer token currently presented in the Authorization header. Useful for verifying that a token corresponds to the expected partner application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth2",
                "info"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "94c6f595-a61b-4c3d-bbe6-3773f6f94b55",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "oauth2",
                    "info"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
