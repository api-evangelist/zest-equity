      "id": "db9ea2fd-9a9a-47ba-8ef2-fdd12b207f71",
      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 JWT-Bearer assertion grant. Exchange a partner-signed JWT for a short-lived bearer access token, then send that token in the Authorization header on every partner API call.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4da347c2-fa89-458e-a6b7-380e4e650055",
          "name": "Exchange a JWT assertion for an access token",
          "request": {
            "name": "Exchange a JWT assertion for an access token",
            "description": {
              "content": "OAuth 2.0 JWT-Bearer assertion grant. Submit `grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer` plus a signed JWT `assertion`. Returns a short-lived bearer access token used for subsequent partner API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth2",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
