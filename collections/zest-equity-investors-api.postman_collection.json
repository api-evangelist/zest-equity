      "name": "Investors",
      "description": {
        "content": "Bulk-create investor records with partial-success semantics. Each row carries its own status / error envelope so a single bad row never fails the batch.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5b63e712-e17c-4f2e-be28-4cc6961ca231",
          "name": "Bulk create investors",
          "request": {
            "name": "Bulk create investors",
            "description": {
              "content": "Creates one or more investor records. Always returns 200 with a per-row { status, zestPersonId | error } result keyed by `partnerInvestorId`. Idempotent across replays: a repeated `partnerInvestorId` returns the existing Zest person id. `Idempotency-Key` is optional and provides response-level caching.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "investors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "key": "Idempotency-Key",
                "value": "<string>",
                "description": ""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"investors\": [\n    {\n      \"partnerInvestorId\": \"<string>\",\n      \"email\": \"<string>\",\n      \"firstName\": \"<string>\",\n      \"lastName\": \"<string>\",\n      \"dateOfBirth\": \"<string>\",\n      \"countryOfResidence\": \"<string>\"\n    },\n    {\n      \"partnerInvestorId\": \"<string>\",\n      \"email\": \"<string>\",\n      \"firstName\": \"<string>\",\n      \"lastName\": \"<string>\",\n      \"dateOfBirth\": \"<string>\",\n      \"countryOfResidence\": \"<string>\"\n    }\n  ]\n}",
              "options": {
