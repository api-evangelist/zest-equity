                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "spv_slug",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "key": "Idempotency-Key",
                "value": "<string>",
                "description": ""
              },
