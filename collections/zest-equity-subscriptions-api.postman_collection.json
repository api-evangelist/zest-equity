          "request": {
            "name": "Create subscriptions for one SPV",
            "description": {
              "content": "Creates one or more subscription rows for a single SPV. Per investor: lump sum + share class. `Idempotency-Key` is optional.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "spvs",
                ":spv_slug",
                "subscriptions"
              ],
